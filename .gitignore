# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Drafts and scratch work — keep unpublished content out of the public repo
drafts/
scratch/
*.draft.md

# Instructor-only materials — answer keys, quiz answers, speaker scripts, student
# handout solutions. Never push these; students (and future students) can see this repo.
instructor-private/
**/instructor-private/

# Class calendar/pacing schedule — instructor-only, not for students. Real copy lives
# in instructor-private/; these root-level names are ignored as a safety net in case
# a stray copy ever ends up at repo root.
/NET-3100BB2-schedule.md
/NET-3100BB2-schedule.xlsx

# Local env / secrets (should never be needed in this repo, but just in case)
.env
*.pem
*.key

# Logs
*.log

# Node (if any tooling gets added later, e.g. link checkers, linters)
node_modules/

# Python (if any scripts get added later)
__pycache__/
*.pyc
.venv/
venv/
